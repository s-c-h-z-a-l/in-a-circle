#!/usr/bin/env bash
# Pre-commit hook: formatting and "every target compiles", checked on the
# STAGED tree.
#
# Checks (never modifies the user's files):
#   1. cargo fmt --all --check
#   2. cargo check --workspace --all-targets --quiet
#
# Why the index and not the working tree: this hook used to check the
# working tree, so a commit that staged only part of a change passed
# whenever the rest of the change sat unstaged next to it. Two such commits
# reached main (82781bb, de5c989); neither built on its own. The hook now
# exports exactly the tree being committed (the index, or the temporary
# index of `git commit <paths>`) and checks that. Unstaged edits and
# untracked files cannot influence the result; a path deleted in the index
# is absent from the export.
#
# Why `--all-targets`: it builds tests, benches and examples too, which is
# exactly what a plain `cargo check` misses (a commit whose test target did
# not compile was once pushed).
#
# Why not the full test suite: its cost per commit would slow the many
# small commits down by minutes. The suite runs at the end of each task and
# in CI.
#
# Cache: everything the hook owns lives in <repo>/target/pre-commit/
# (target/ is gitignored, so nothing lands in tracked files or the home
# directory):
#   tree/      the export of the last checked index
#   target/    CARGO_TARGET_DIR for that export. Separate from the user's
#              own target/: cargo fingerprints workspace crates by path, so
#              sharing one dir between two source paths would rebuild
#              everything on every alternation.
#   tree.id    git tree id that tree/ currently holds
#   lock       serialises two commits running at the same time
# Only these files are ever replaced or removed. A commit updates tree/ by
# the difference between tree.id and the new index (`git diff-tree`), so a
# file is rewritten, and gets a new mtime, only when it changed; cargo then
# rebuilds only the crates that changed. A missing or unusable tree.id
# means a full export into an emptied tree/.
#
# Enable (once per clone; shared by all its worktrees):
#   git config core.hooksPath scripts/git-hooks
#
# Bypassing it with --no-verify defeats the purpose; do not.
set -eu

# Doc- and notes-only commits stay instant: nothing to compile or format
# unless Rust or Cargo inputs are part of the commit.
if ! git diff --cached --name-only | grep -qE '(\.rs$|(^|/)Cargo\.toml$|(^|/)Cargo\.lock$|^\.cargo/|(^|/)rust-toolchain(\.toml)?$|(^|/)rustfmt\.toml$|(^|/)\.rustfmt\.toml$)'; then
  exit 0
fi

top=$(git rev-parse --show-toplevel)
cache="$top/target/pre-commit"
tree="$cache/tree"
mkdir -p "$cache"

# One checker at a time: the export and its stamp are shared state. The
# lock is released when this shell exits. No flock (not Linux): the risk is
# two overlapping commits in one clone, which a person does not do.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$cache/lock"
  flock 9
fi

new=$(git write-tree) || {
  echo "pre-commit: FAILED to read the index ('git write-tree'); resolve unmerged paths first." >&2
  exit 1
}
old=
[ -f "$cache/tree.id" ] && old=$(cat "$cache/tree.id")
# The stamp is dropped before the tree is touched, so an interrupted
# update is never mistaken for a complete export.
rm -f "$cache/tree.id"

if [ -n "$old" ] && [ -d "$tree" ] && git cat-file -e "$old^{tree}" 2>/dev/null; then
  # Incremental: apply only the difference between the two trees. Deletions
  # first, so a file that became a directory (or back) is replaced cleanly.
  adds=()
  while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    case "$status" in
      D)
        rm -f -- "$tree/$path"
        rmdir -p --ignore-fail-on-non-empty -- "$tree/$(dirname -- "$path")" 2>/dev/null || true
        ;;
      *) adds+=("$path") ;;
    esac
  done < <(git diff-tree -r -z --no-renames --name-status "$old" "$new")
  if [ "${#adds[@]}" -gt 0 ]; then
    printf '%s\0' "${adds[@]}" | git checkout-index -f -z --stdin --prefix="$tree/"
  fi
else
  # Full export. tree/ holds only files this hook wrote, so it is safe to
  # empty; the cargo target dir beside it is kept.
  rm -rf -- "$tree"
  mkdir -p "$tree"
  git checkout-index -a -f --prefix="$tree/"
fi
printf '%s\n' "$new" >"$cache/tree.id"

# The export is checked as a stand-alone tree: git variables of this commit
# must not leak into cargo, rustfmt or build scripts running there.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
cd "$tree"
export CARGO_TARGET_DIR="$cache/target"

if ! cargo fmt --all --check >/dev/null 2>&1; then
  echo "pre-commit: FAILED step 'cargo fmt --all --check' (on the staged tree); fix: run 'cargo fmt --all' and re-stage." >&2
  cargo fmt --all --check 2>&1 | head -20 >&2 || true
  exit 1
fi

# Bound memory for cargo when a user systemd manager is available (a
# runaway build must not take the machine down); plain cargo otherwise,
# e.g. in CI or containers.
if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1 \
  || { command -v systemctl >/dev/null 2>&1 && [ "$(systemctl --user is-system-running 2>/dev/null)" = degraded ]; }; then
  run=(systemd-run --user --scope -q --slice=inacircle-tests.slice -p MemoryMax=60G -p MemorySwapMax=0 --)
else
  echo "pre-commit: no systemd user manager; running cargo without a memory scope." >&2
  run=()
fi

if ! ${run[@]+"${run[@]}"} cargo check --workspace --all-targets --quiet; then
  echo "pre-commit: FAILED step 'cargo check --workspace --all-targets' (on the staged tree); fix the compile errors above (tests and benches included) and re-stage." >&2
  exit 1
fi
