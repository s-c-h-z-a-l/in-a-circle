<?xml version="1.0" encoding="UTF-8"?>
<!-- Referenced styles (TTML2 10.4.1.2, 10.4.1.3): a style attribute lists styles that
     merge left to right, so the later one wins; a style may reference styles itself,
     and its own declarations come last; an inline declaration beats every reference
     (10.4.1.1). -->
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head>
    <styling>
      <style xml:id="ital" tts:fontStyle="italic"/>
      <style xml:id="bold" tts:fontWeight="bold"/>
      <style xml:id="plain" tts:fontStyle="normal"/>
      <style xml:id="both" style="ital bold" tts:textDecoration="underline"/>
    </styling>
  </head>
  <body>
    <div>
      <p begin="0s" end="1s" style="ital plain bold">first</p>
      <p begin="1s" end="2s" style="both">second</p>
      <p begin="2s" end="3s"><span style="ital" tts:fontStyle="normal">third</span> fourth</p>
    </div>
  </body>
</tt>
