<?xml version="1.0" encoding="UTF-8"?>
<!-- A loop of chained references (TTML2 10.4.1.3: "A loop in a sequence of chained
     style references must be considered an error"). The reader refuses the reference
     that closes the loop, counts it as Styling, and reads the rest. -->
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head>
    <styling>
      <style xml:id="a" style="b" tts:fontStyle="italic"/>
      <style xml:id="b" style="a" tts:fontWeight="bold"/>
      <style xml:id="c" style="c"/>
    </styling>
  </head>
  <body>
    <div>
      <p begin="0s" end="1s" style="a">loop</p>
      <p begin="1s" end="2s" style="c">self</p>
    </div>
  </body>
</tt>
