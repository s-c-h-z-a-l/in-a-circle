+//! Temporary diagnostic probes; not part of the product branch.
+use std::{cell::RefCell, sync::OnceLock};
+struct Point { label: &'static str, user: i64, sys: i64, minor: i64, major: i64, ns: i64 }
+thread_local! { static POINTS: RefCell<Vec<Point>> = RefCell::new(Vec::with_capacity(32)); }
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("INACIRCLE_PHASE_PROFILE").is_some())
+}
+pub fn mark(label: &'static str) {
+    if !enabled() { return; }
+    // SAFETY: both libc output structures are valid and zero-initialized.
+    let (mut r, mut t) = unsafe { (std::mem::zeroed::<libc::rusage>(), std::mem::zeroed::<libc::timespec>()) };
+    // SAFETY: valid writable output structures; constant selectors.
+    unsafe { libc::getrusage(libc::RUSAGE_SELF, &mut r); libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut t); }
+    POINTS.with(|p| p.borrow_mut().push(Point { label, user: r.ru_utime.tv_sec*1_000_000+r.ru_utime.tv_usec, sys: r.ru_stime.tv_sec*1_000_000+r.ru_stime.tv_usec, minor: r.ru_minflt, major: r.ru_majflt, ns:t.tv_sec*1_000_000_000+t.tv_nsec }));
+}
+pub fn dump() {
+    if !enabled() { return; }
+    POINTS.with(|p| for v in p.take() {
+        eprintln!("inacircle: profile label={} user_us={} sys_us={} minflt={} majflt={} mono_ns={}",v.label,v.user,v.sys,v.minor,v.major,v.ns);
+    });
+}
