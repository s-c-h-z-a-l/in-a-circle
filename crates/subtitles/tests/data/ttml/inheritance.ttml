<?xml version="1.0" encoding="UTF-8"?>
<!-- Content style inheritance (TTML2 10.4.2.1) and region style inheritance
     (10.4.2.2). Inheritable values pass to the spans of a paragraph; a value that
     an ancestor gives is used before the region's. Non-inheritable values
     (tts:displayAlign, tts:origin, tts:padding) stay on their element. -->
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head>
    <styling>
      <style xml:id="base" tts:fontStyle="italic" tts:fontWeight="bold"/>
    </styling>
    <layout>
      <region xml:id="r" tts:textDecoration="underline" tts:fontStyle="normal"/>
    </layout>
  </head>
  <body style="base" tts:textDecoration="none">
    <div>
      <p begin="0s" end="1s"><span tts:fontWeight="normal">a</span>b</p>
      <p begin="1s" end="2s" region="r">c</p>
      <p begin="2s" end="3s" tts:displayAlign="after" tts:padding="1px"><span>d</span></p>
    </div>
  </body>
</tt>
